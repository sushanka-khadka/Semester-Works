@{
    ViewData["Title"] = "Logout Confirmation";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h3 class="card-title mb-4">Are you sure you want to logout?</h3>
                    <p class="mb-4">You will be logged out and your session will end.</p>

                    <div class="d-flex justify-content-center gap-3">
                        <form asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-danger">Yes, Logout</button>
                        </form>

                        <a asp-action="Index" class="btn btn-secondary">No, Stay Logged In</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>