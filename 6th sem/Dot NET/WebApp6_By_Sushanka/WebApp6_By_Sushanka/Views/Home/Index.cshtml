@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">Welcome</h3>

                    <form asp-action="Index" method="post">
                        <div class="mb-3">
                            <label for="username" class="form-label">Enter your name to store in cookies:</label>
                            <input type="text" name="username" id="username" class="form-control" required />
                        </div>
                        <div class="text-center">
                            <input type="submit" value="Set Cookie" class="btn btn-primary" />
                        </div>
                    </form>

                    <div class="mt-4 text-center">
                        <a asp-action="GetCookies" class="btn btn-success me-2">Read Cookies</a>
                        <a asp-action="DeleteCookies" class="btn btn-danger">Delete Cookies</a>
                    </div>

                    @if (TempData["CookieValue"] != null)
                    {
                        <div class="alert alert-info mt-3 text-center">
                            Cookie Value: @TempData["CookieValue"]
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4">
                <partial name="_CreateUser.cshtml" />
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}