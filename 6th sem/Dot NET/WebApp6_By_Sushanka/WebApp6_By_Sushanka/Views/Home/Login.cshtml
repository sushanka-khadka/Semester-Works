@{
	ViewBag.Title = "Login";
}

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-md-5">
			<div class="card shadow-sm">
				<div class="card-body">
					<h3 class="card-title text-center mb-4">Login</h3>

                    <form action="Login" method="post">
                        <div class="mb-3">
                            <label for="username" class="form-label">Username:</label>
                            <input name="username" value="@ViewBag.SavedUsername" id="username" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password:</label>
                            <input name="password" id="password" type="password" class="form-control" required />
                        </div>
                        <div class="form-check mb-3">
                            <input name="rememberMe" type="checkbox" @(ViewBag.SavedUsername != null ? "checked" : "") value="true" class="form-check-input" id="rememberMe" /> @*if value is not set it will return "on" & it will not be converted to bool*@
                            <label class="form-check-label" for="rememberMe">Remember Username</label>
                        </div>
                        <div class="text-center">
                            <input type="submit" value="Login" class="btn btn-primary w-100" />
                        </div>
                    </form>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-3 text-center">
                            @ViewBag.Error
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>