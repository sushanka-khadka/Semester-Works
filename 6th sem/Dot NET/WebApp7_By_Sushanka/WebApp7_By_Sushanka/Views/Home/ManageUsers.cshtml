<h2>User Management</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Email</th>
            <th>Roles</th>
            <th>Claims</th>
            <th>Policies</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@string.Join(", ", user.Roles)</td>
                <td>
                    @foreach (var claim in user.Claims)
                    {
                        <div>@claim</div>
                    }
                </td>
                <td>
                    @foreach (var policy in user.Policies)
                    {
                        <div>@policy</div>
                    }
                </td>
                <td>
                    <!-- Manage Roles Button -->
                    <button class="btn btn-sm btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#manageRolesModal"
                            data-userid="@user.UserId"
                            data-email="@user.Email">
                        Manage Roles
                    </button>

                    <!-- Manage Claims Button -->
                    <button class="btn btn-sm btn-warning"
                            data-bs-toggle="modal"
                            data-bs-target="#manageClaimsModal"
                            data-userid="@user.UserId"
                            data-email="@user.Email">
                        Manage Claims
                    </button>

                    <!-- Manage Policies Button -->
                    <button class="btn btn-sm btn-success"
                            data-bs-toggle="modal"
                            data-bs-target="#managePoliciesModal"
                            data-userid="@user.UserId"
                            data-email="@user.Email">
                        Manage Policies
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- 🔹 Manage Roles Modal -->
<div class="modal fade" id="manageRolesModal" tabindex="-1" aria-labelledby="rolesLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="rolesLabel">Manage Roles for <span id="rolesUserEmail"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-action="AddRole">
                    <input type="hidden" id="rolesUserId" name="userId" />
                    <div class="mb-3">
                        <label>Role Name</label>
                        <input type="text" name="role" class="form-control" placeholder="Enter role" />
                    </div>
                    <button type="submit" class="btn btn-success">Add Role</button>
                </form>
                <form method="post" asp-action="RemoveRole" class="mt-2">
                    <input type="hidden" id="rolesUserIdRemove" name="userId" />
                    <div class="mb-3">
                        <label>Role Name</label>
                        <input type="text" name="role" class="form-control" placeholder="Enter role to remove" />
                    </div>
                    <button type="submit" class="btn btn-danger">Remove Role</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- 🔹 Manage Claims Modal -->
<div class="modal fade" id="manageClaimsModal" tabindex="-1" aria-labelledby="claimsLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="claimsLabel">Manage Claims for <span id="claimsUserEmail"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-action="AddClaim">
                    <input type="hidden" id="claimsUserId" name="userId" />
                    <div class="mb-3">
                        <label>Claim Type</label>
                        <input type="text" name="type" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Claim Value</label>
                        <input type="text" name="value" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-success">Add Claim</button>
                </form>
                <form method="post" asp-action="RemoveClaim" class="mt-2">
                    <input type="hidden" id="claimsUserIdRemove" name="userId" />
                    <div class="mb-3">
                        <label>Claim Type</label>
                        <input type="text" name="type" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Claim Value</label>
                        <input type="text" name="value" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-danger">Remove Claim</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- 🔹 Manage Policies Modal (Read-only info) -->
<div class="modal fade" id="managePoliciesModal" tabindex="-1" aria-labelledby="policiesLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="policiesLabel">Policies for <span id="policiesUserEmail"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>This user’s policy status is shown in the table already.</p>
                <span>— a policy is just a logical rule that evaluates roles/claims.</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var rolesModal = document.getElementById('manageRolesModal');
        rolesModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var userId = button.getAttribute('data-userid');
            var email = button.getAttribute('data-email');
            document.getElementById('rolesUserId').value = userId;
            document.getElementById('rolesUserIdRemove').value = userId;
            document.getElementById('rolesUserEmail').innerText = email;
        });

        var claimsModal = document.getElementById('manageClaimsModal');
        claimsModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var userId = button.getAttribute('data-userid');
            var email = button.getAttribute('data-email');
            document.getElementById('claimsUserId').value = userId;
            document.getElementById('claimsUserIdRemove').value = userId;
            document.getElementById('claimsUserEmail').innerText = email;
        });

        var policiesModal = document.getElementById('managePoliciesModal');
        policiesModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var email = button.getAttribute('data-email');
            document.getElementById('policiesUserEmail').innerText = email;
        });
    </script>
}
